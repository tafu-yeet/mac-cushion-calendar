# Copy this file to worker/.env and fill in the values. Never commit worker/.env.

# Residential proxy for the primary Instagram backend. PROXY_PORTS is one port
# or a range like 10000-10499; each port is a separate sticky IP.
PROXY_HOST=
PROXY_LOGIN=
PROXY_PASSWORD=
PROXY_PORTS=

# Apify API token for the fallback backend.
APIFY_TOKEN=

# Supabase project URL and secret key (Project Settings > API Keys). The secret
# key bypasses row level security, so it only ever lives on the worker.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# LLM keys for event extraction (EXTRACTOR picks which one is used).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                 # free key: aistudio.google.com

# Optional overrides (defaults shown).
# FETCH_BACKEND=auto            # auto | primary | apify
# EXTRACTOR=claude              # first pass: claude | gemini
# CLAUDE_MODEL=claude-haiku-5-5 # first-pass Claude model
# VERIFY_MODEL=claude-sonnet-5-5 # rechecks every event post; "none" turns it off
# TIEBREAK_MODEL=claude-opus-5-5 # reads a post again when the first two disagree; "none" turns it off
# AUTO_APPROVE_MIN_CONFIDENCE=0.9 # publish confident, rechecked free-food events; "none" reviews all
# AUTO_APPROVE_OTHER_MIN_CONFIDENCE=0.75 # the same for events without free food
# EXTRACT_EFFORT=xhigh          # how hard the first pass thinks (Haiku 5.5; Haiku 4.5 ignores it)
# CHECK_EFFORT=medium           # how hard the Sonnet check and Opus tie-breaker think
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MIN_INTERVAL_S=5
# MAX_POST_AGE_DAYS=7
# SKIP_REELS=true               # "false" reads reels and other videos too
# MAX_EXTRACTIONS_PER_RUN=50
