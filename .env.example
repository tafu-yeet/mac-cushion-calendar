# Copy to .env.local, and set the same names in Vercel (Project > Settings > Environment Variables).

# Supabase > Project Settings > API Keys. The publishable key is public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, never NEXT_PUBLIC_: the secret key (sb_secret_...) bypasses row level security.
# Used by the member email job and "Delete my account".
SUPABASE_SECRET_KEY=

# Resend > API Keys (sending access, for the maccushion.ca domain). Member emails.
RESEND_API_KEY=

# A long random string. pg_cron sends it to /api/cron/email; keep a copy in Supabase Vault
# as "cron_secret" (see supabase/migrations/20261124130000_member_email_cron.sql).
CRON_SECRET=
